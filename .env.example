# Nothing here is read unless the flags below are 1.
FLY_RH_LIVE=0
FLY_SOL_LIVE=0
FLY_ALLOW_BROWSER=0

# The fly's Robinhood Chain wallet. Created by `py rhwallet.py new`.
# Never paste a live key into a chat window - anything pasted there is burned.
FLY_RH_SECRET=

FLY_RH_RPC=https://rpc.mainnet.chain.robinhood.com

# The fly's Solana wallet. Created by `py solwallet.py new`. Distinct from
# FLY_RH_SECRET. Signing for Stonkfun and Phoenix happens in-process from this
# secret; roam/voice never see it. FLY_SOL_LIVE=1 is what arms a Stonkfun
# submit or a Phoenix live order — both stay off until you set it.
FLY_SOL_SECRET=

# Solana JSON-RPC for send/confirm and balance. Not the Robinhood Chain RPC
# and not a Stonkfun-issued key.
FLY_SOL_RPC=https://api.mainnet-beta.solana.com

# PumpFun live launches (JSON frames, not the HTML page).
FLY_CLAWD_WS=wss://clawd-ws.fly.dev/ws

# Stonkfun public HTTP. No API key; a launch is authorised by the wallet
# signature on the fee payment.
FLY_STK_API=https://www.stonkfun.xyz/api/public/v1

# Phoenix Eternal perps REST. Reads are open; live orders stay disarmed.
FLY_PX_API=https://perp-api.phoenix.trade

# --- the voice ---------------------------------------------------------------
# A language model narrates the fly's journal from its real telemetry. The
# neurons and numbers are real; the words are the narrator's. Disclosed.
OPENROUTER_API_KEY=
FLY_VOICE_MODEL=anthropic/claude-opus-5     # "stub" = offline test mode, no key needed
FLY_VOICE_EVERY_H=3                          # hours between journal entries
FLY_VOICE_DRY=1                              # 1 = write the journal, never post to X
FLY_STREAM=https://flybrain-production-2b26.up.railway.app

# --- X, post-only ------------------------------------------------------------
# From a developer app on the account the fly posts as. Read and Write scope.
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_MAX_POSTS_PER_DAY=8
